# Supabase — copy to .env.local and fill with your project values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose with NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp checkout (international format, digits only, e.g. 15551234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Customer service inbox shown on /contact
NEXT_PUBLIC_CONTACT_EMAIL=

# Storefront
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=USD
